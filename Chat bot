import tkinter as tk
from google import genai
from tkinter import messagebox

class ChatBot:
    def __init__(self,root):
        self.root=root
        self.root.title('Chat Bot')
        self.root.geometry('450x500')
        self.root.configure(bg="#d18e8e")

        self.title_lb=tk.Label(self.root,text="Your Chatbot",font=('Arial',15,'bold'),bg='#d18e8e',fg='#333333')
        self.title_lb.pack(pady=10)

        self.reply_lb=tk.Label(self.root,text="ask me anything",font=('Arial',13,'bold'),bg='#d18e8e',fg='#333333')
        self.reply_lb.pack(pady=20)
        
        self.entry_box=tk.Text(self.root,width=35,height=6)
        self.entry_box.pack(pady=10)

        self.send_btn=tk.Button(self.root,text='Send',font=('Arial',13,'bold'),bg="#3f779c",fg='#ffffff',command=self.generate)
        self.send_btn.pack(pady=20)

        #enter your api key
        self.client=genai.Client(api_key='')

    def generate(self):
        msg=self.entry_box.get('1.0','end-1c')
      

        if not msg:
            messagebox.showinfo('Invalid','Pls enter something first')
            return

        models_to_try=['gemini-3.5-flash','gemini-3.6-flash','gemini-3.7-flash','gemini-3.8-flash']

        reply=None
        for model_name in models_to_try:
           try:
               print(f'Trying {model_name}')
               response= self.client.models.generate_content(
               model= model_name,contents=msg
            
        )
               reply=response.text
               break
           except Exception as e:
               print(f'{model_name} fail: {e}')
               continue

        if reply:
           self.reply_lb.config(text=reply)
        else:
            self.reply_lb.config(text='All models are busy, try 2 min later')

        self.entry_box.delete('1.0','end')
        





if __name__=="__main__":
    window=tk.Tk()
    app=ChatBot(window)
    window.mainloop()
